rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the caller is the group's creator
    function isGroupCreator(groupId) {
      return request.auth != null && 
        request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy;
    }

    // Public group metadata, aggregate sweet spot recommendations, and aggregate payment summary
    match /groups/{groupId} {
      // Anyone with the link or ID can read public group details
      allow read: if true;

      // Any authenticated (including anonymous) user can create a group
      allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid;

      // Creator can update all fields (settings, status, reveal, agreed amount, gift brief, lock)
      // Group participants can update aggregate counts during join/submit
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.createdBy ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participantCount',
          'responseCount',
          'recommendation',
          'recommendedAmount',
          'totalBudget',
          'comfortableCount',
          'stretchingCount',
          'conservativeAmount',
          'generousAmount',
          'explanation',
          'consensusStrength',
          'recommendationStatus',
          'lastActivityAt',
          'aggregatePayments'
        ])
      );

      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;

      // Group Participants: public-safe identity only (name, joinedAt, hasSubmitted, role)
      // NO individual payment status or budgets on this document!
      match /participants/{participantId} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == participantId;
        allow update: if request.auth != null && (
          request.auth.uid == participantId ||
          isGroupCreator(groupId)
        );
        allow delete: if isGroupCreator(groupId);
      }

      // Private Budgets: STRICT PRIVACY ENFORCEMENT
      // A participant can ONLY read, create, and update their OWN budget.
      // Neither other participants nor the creator can view raw individual numbers.
      match /budgets/{participantId} {
        allow read: if request.auth != null && request.auth.uid == participantId;
        allow create: if request.auth != null && request.auth.uid == participantId;
        allow update: if request.auth != null && request.auth.uid == participantId;
        allow delete: if request.auth != null && request.auth.uid == participantId;
      }

      // Creator & Participant Payment Records:
      // Only the individual participant or the group creator can read.
      // Only the creator can mark verified payments.
      match /payments/{participantId} {
        allow read: if request.auth != null && (
          request.auth.uid == participantId ||
          isGroupCreator(groupId)
        );
        allow create, update: if request.auth != null && isGroupCreator(groupId);
        allow delete: if request.auth != null && isGroupCreator(groupId);
      }

      // Payment Claims: "I've paid" self-confirmations with optional UPI ref / note
      match /paymentClaims/{participantId} {
        allow read: if request.auth != null && (
          request.auth.uid == participantId ||
          isGroupCreator(groupId)
        );
        allow create, update: if request.auth != null && (
          request.auth.uid == participantId ||
          isGroupCreator(groupId)
        );
        allow delete: if request.auth != null && (
          request.auth.uid == participantId ||
          isGroupCreator(groupId)
        );
      }

      // Gift Options: Options proposed for the group gift
      match /giftOptions/{giftId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
        allow delete: if isGroupCreator(groupId);
      }

      // Votes: Group voting on gift options or contribution tiers
      match /votes/{participantId} {
        allow read: if true;
        allow create, update: if request.auth != null && request.auth.uid == participantId;
        allow delete: if request.auth != null && request.auth.uid == participantId;
      }

      // Cross-device Recovery Tokens
      match /recoveryTokens/{tokenId} {
        allow read: if true;
        allow create: if request.auth != null;
      }
    }

    // Short Share Codes (e.g. 7XKP92 -> groupId)
    match /shareCodes/{code} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if false;
    }
  }
}
