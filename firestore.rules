rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helper: Check if caller is authenticated and matches group creator
    function isGroupCreator(groupId) {
      return (request.auth != null && 
        request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy) ||
        request.auth == null;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Public group metadata, aggregate recommendations, and phase status
    match /groups/{groupId} {
      // Anyone with the link or share code can read public group details
      allow read: if true;

      // Authenticated users or guest organizers can create a new group
      allow create: if (request.auth != null && request.resource.data.createdBy == request.auth.uid) ||
        (request.auth == null && request.resource.data.createdBy is string && request.resource.data.createdBy.size() > 0);

      // Group creator or organizer can update group document
      allow update: if (request.auth != null && isGroupCreator(groupId)) || request.auth == null;

      // Group creator can delete
      allow delete: if (request.auth != null && request.auth.uid == resource.data.createdBy) || request.auth == null;

      // Group Participants
      match /participants/{participantId} {
        allow read: if true;

        allow create: if (request.auth != null && request.auth.uid == participantId) ||
          (request.auth == null && participantId is string && participantId.size() > 0);

        allow update: if true;
        allow delete: if isGroupCreator(groupId);
      }

      // Private Budgets
      match /budgets/{participantId} {
        allow read: if (request.auth != null && request.auth.uid == participantId) || request.auth == null;
        allow create, update: if ((request.auth != null && request.auth.uid == participantId) || request.auth == null) &&
          request.resource.data.feelsRight >= 0;
        allow delete: if (request.auth != null && request.auth.uid == participantId) || request.auth == null;
      }

      // Payments
      match /payments/{participantId} {
        allow read: if true;
        allow create, update, delete: if true;
      }

      // Payment Claims
      match /paymentClaims/{participantId} {
        allow read: if true;
        allow create, update, delete: if true;
      }

      // Gift Options
      match /giftOptions/{giftId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if isGroupCreator(groupId);
      }

      // Votes
      match /votes/{participantId} {
        allow read: if true;
        allow create, update, delete: if true;
      }

      // Proposal Votes
      match /proposalVotes/{participantId} {
        allow read: if true;
        allow create, update, delete: if true;
      }

      // Cross-device Recovery Tokens
      match /recoveryTokens/{tokenHash} {
        allow list: if false;
        allow get: if true;
        allow create: if true;
        allow update, delete: if false;
      }
    }

    // Short Share Codes (e.g. 7XKP92 -> groupId)
    match /shareCodes/{code} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
